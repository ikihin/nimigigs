# Web (optional — default uses Vite proxy /api/v1)
# VITE_API_URL=http://localhost:8787/api/v1

# Server
PORT=8787
APP_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:8787

# ── Supabase (Postgres) ───────────────────────────────
# Project Settings → API
# URL: https://xxxx.supabase.co
# service_role key (secret — server only, never ship to browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Then run SQL in Dashboard → SQL Editor:
#   supabase/schema.sql

# Allow paste-handle stub when OAuth apps not ready (default true)
OAUTH_ALLOW_STUB=true

# ── GitHub OAuth App ──────────────────────────────────
# Create at https://github.com/settings/developers → New OAuth App
# Homepage: http://localhost:5173
# Authorization callback URL: http://localhost:8787/api/v1/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=http://localhost:8787/api/v1/oauth/github/callback

# ── X / Twitter OAuth 2.0 ─────────────────────────────
# Create at https://developer.x.com/en/portal/dashboard
# App type: Web App, callback: http://localhost:8787/api/v1/oauth/twitter/callback
# Scopes: tweet.read users.read offline.access
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
# TWITTER_REDIRECT_URI=http://localhost:8787/api/v1/oauth/twitter/callback
